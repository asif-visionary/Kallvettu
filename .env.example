# ==============================================================================
# Kallvettu — Ancient Inscription Restoration & Translation Platform
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Ecosystem Credentials
# ------------------------------------------------------------------------------
# Sarvam AI API Key (Document AI Vision, Sarvam Translate, Mayura, Sarvam-105B)
SARVAM_API_KEY=

# Google Gemini Multimodal Vision & Reasoning API Key
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
API_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 2. Ingestion & Security Ceilings
# ------------------------------------------------------------------------------
# Maximum file upload size in megabytes (enforced in Streamlit & CV ingestion)
MAX_UPLOAD_SIZE_MB=50

# Default maximum pixel dimension for CV processing downsampling (preserves original)
MAX_IMAGE_DIM_DEFAULT=1600

# ------------------------------------------------------------------------------
# 3. Computer Vision & Restoration Defaults
# ------------------------------------------------------------------------------
# Contrast Limited Adaptive Histogram Equalization (CLAHE)
CLAHE_CLIP_LIMIT_DEFAULT=2.5

# Sauvola Adaptive Local Thresholding
SAUVOLA_K_DEFAULT=0.20
SAUVOLA_WINDOW_DEFAULT=25

# ------------------------------------------------------------------------------
# 4. Runtime Environment
# ------------------------------------------------------------------------------
KALLVETTU_ENV=production
KALLVETTU_DEBUG=false

